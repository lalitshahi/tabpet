{
  "manifest_version": 3,
  "name": "Tab Pet",
  "short_name": "Tab Pet",
  "version": "0.1.0",
  "description": "A tiny pet that eats the tabs you forgot. It saves every one in its belly, so nothing is lost, and shows the memory you got back.",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["tabs"],
  "action": {
    "default_title": "Tab Pet",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
